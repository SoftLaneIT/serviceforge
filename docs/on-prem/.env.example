# ServiceForge Platform — Environment Configuration
# Copy this file to .env and fill in values
# cp .env.example .env

# ── Platform Version ──
SF_VERSION=latest
SF_ENVIRONMENT=production     # production | staging | development

# ── Logging ──
SF_LOG_LEVEL=info             # debug | info | warn | error
SF_LOG_FORMAT=json            # json | text

# ── PostgreSQL ──
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_PORT=5432

# ── Redis ──
REDIS_PASSWORD=
REDIS_PORT=6379

# ── Kafka ──
KAFKA_PORT=9092

# ── Traefik / Reverse Proxy ──
HTTP_PORT=80
HTTPS_PORT=443
TRAEFIK_LOG_LEVEL=WARN

# ── Public URLs (used by Management UI) ──
PUBLIC_API_URL=http://localhost/api
PUBLIC_WS_URL=ws://localhost/ws

# ── Monitoring ──
GRAFANA_PASSWORD=admin

# CLOUD INFRASTRUCTURE (only for hybrid mode)
# Used with: docker-compose.cloud-infra.yml
# EXTERNAL_DATABASE_URL=postgres://user:pass@your-rds-host:5432/serviceforge?sslmode=require
# EXTERNAL_REDIS_URL=rediss://user:pass@your-elasticache-host:6380
# EXTERNAL_KAFKA_BROKERS=b-1.your-msk-cluster:9092,b-2.your-msk-cluster:9092

# TLS / HTTPS (optional, for production on-prem)
# Place cert files in deploy/docker/traefik/certs/
# TLS_CERT_FILE=cert.pem
# TLS_KEY_FILE=key.pem
